# Local container defaults. Copy to .env if you want to change them.
OPENIQ_PORT=8765
OPENIQ_BIND=127.0.0.1
# SQLite is the supported deployment backend. See docs/DATABASES.md for extensions.
DATABASE_BACKEND=sqlite
# Leave DATABASE_PATH unset to use the normal local/container data directory.
# DATABASE_NAME=  # PostgreSQL configuration scaffold; driver and validation pending.
# DATABASE_USER=
# DATABASE_PASSWORD=
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_SSLMODE=prefer
ALLOW_LOCAL_LOGIN=0
SEED_DEMO=1
DEMO_PASSWORD=prototype-local-2026
ENABLE_BACKEND_ADMIN=1
BACKEND_ADMIN_USERNAME=openiq-admin
ALLOWED_HOSTS=localhost,127.0.0.1
HTTPS=0
TRUST_PROXY=0
CSRF_TRUSTED_ORIGINS=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8765/auth/discord/callback/
DISCORD_BOT_TOKEN=
ENABLE_DISCORD_DELIVERY=0
# Set one sync mode. Guild sync is fast for staging; global sync is for normal use.
DISCORD_SYNC_GLOBAL=1
DISCORD_SYNC_GUILD=
