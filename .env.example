# Local container defaults. Copy to .env if you want to change them.
OPENIQ_PORT=8765
OPENIQ_BIND=127.0.0.1
ALLOW_LOCAL_LOGIN=0
SEED_DEMO=1
DEMO_PASSWORD=prototype-local-2026
ENABLE_BACKEND_ADMIN=1
BACKEND_ADMIN_USERNAME=openiq-admin
ALLOWED_HOSTS=localhost,127.0.0.1
HTTPS=0
TRUST_PROXY=0
CSRF_TRUSTED_ORIGINS=
